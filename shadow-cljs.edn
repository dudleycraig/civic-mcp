{:deps      {:aliases
             [:conjure ;; NOTE: :conjure alias loaded from ~/.clojure/deps.edn
              :prod-ui :dev-ui :test-ui]}

 :dev-http  {#shadow/env ["SHADOW_PORT" :as :int]
             {:root "resources/public"
              :headers {"Access-Control-Allow-Origin" "http://127.0.0.1:3001"
                        "Access-Control-Allow-Methods" "GET, PUT, POST, DELETE, OPTIONS"
                        "Access-Control-Allow-Credentials" "true"
                        "Access-Control-Allow-Headers" "x-jnet-api, x-csrf-token, x-requested-with, accept, accept-encoding, accept-language, set-cookie, authorization, content-type, origin"}}}

 :nrepl     {:port 7888}

 :builds    {:ui
             {:target           :browser
              :js-options       {:js-provider :shadow
                                 :local-index true}
              :output-dir       "resources/public/js"
              :asset-path       "/js"
              :modules          {:ui {:init-fn ui.main/init}}
              :build-hooks      [(shadow-env.core/hook)]
              :devtools         {:watch-dir "resources/public"
                                 :http-root "resources/public"}
              :compiler-options {:optimizations :none}
              :closure-defines  {ui.system.configuration/shadow-active   #shadow/env ["SHADOW_ACTIVE" {:as :bool}]
                                 ui.system.configuration/shadow-protocol #shadow/env "SHADOW_PROTOCOL"
                                 ui.system.configuration/shadow-host     #shadow/env "SHADOW_HOST"
                                 ui.system.configuration/shadow-port     #shadow/env ["SHADOW_PORT" {:as :int}]
                                 ui.system.configuration/http-cors       #shadow/env ["HTTP_CORS" {:as :bool}]
                                 ui.system.configuration/http-protocol   #shadow/env "HTTP_PROTOCOL"
                                 ui.system.configuration/http-host       #shadow/env "HTTP_HOST"
                                 ui.system.configuration/http-port       #shadow/env ["HTTP_PORT" {:as :int}]

                                 ui.main/pwa?                            #shadow/env ["PWA" {:as :bool}]
                                 ui.main/profile                         #shadow/env "PROFILE"}}}}




